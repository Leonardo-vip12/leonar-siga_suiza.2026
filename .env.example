# ============================================================
# Copia este archivo a ".env" y ajusta los valores.
# Docker Compose lee ".env" de la raiz para la substitucion de variables.
# ============================================================

# ============ PostgreSQL (Base de Datos Principal) ============
# Para Railway: usar la variable RAILWAY_POSTGRES_URL o los valores abajo
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambiar-esta-clave
DB_NAME=siga_core

# ============ NATS Event Bus ============
NATS_URL=nats://localhost:4222

# ============ Redis (Cache) ============
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=null
cache_enabled=true
redis_host=localhost
redis_port=6379
redis_password=null
cache_default_ttl=300

# ============ Aplicación Core ============
app_name=SIGA Core
environment=development
secret_key=cambiar-esta-clave-en-produccion
debug=true

# ============ Módulos ============
modules_auto_discover=true
modules_validate_on_start=true
modules_discovery_sources=["local", "database"]

# ============ Seguridad de Tokens ============
token_expire_minutes=30
module_token_expire_hours=24

# ============ NATS Event Bus (Producción) ============
enable_nats=false
nats_url=nats://localhost:4222

# ============ Frontend (Vite) ============
# Estas variables se inyectan en el frontend via Vite
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
